<UserControl x:Class="FanaBridge.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel>

            <!-- Connection Status -->
            <styles:SHSection Title="DEVICE STATUS" ShowSeparator="True">
                <StackPanel>
                    <!-- Device chain: ● wheelbase › wheel/hub › module.
                         The status dot lives on the wheelbase node (the base is
                         what connects). The wheelbase node is always present so
                         the panel height stays constant across states; the wheel
                         and module nodes are shown/hidden to mirror the stack. -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dotStatus" Width="9" Height="9" Fill="#E0A800"
                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="txtBaseName" Text="Checking…" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <TextBlock x:Name="txtBaseCaption" Text="Wheelbase" Foreground="#888888" FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="connBaseWheel" Text="›" Foreground="#888888" FontSize="20"
                                   VerticalAlignment="Center" Margin="14,0,14,0" />
                        <StackPanel x:Name="nodeWheel" VerticalAlignment="Center">
                            <TextBlock x:Name="txtWheelChain" Text="—" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="txtWheelKind" Text="Wheel" Foreground="#888888" FontSize="11" />
                        </StackPanel>
                        <TextBlock x:Name="connWheelModule" Text="›" Foreground="#888888" FontSize="20"
                                   VerticalAlignment="Center" Margin="14,0,14,0" />
                        <StackPanel x:Name="nodeModule" VerticalAlignment="Center">
                            <TextBlock x:Name="txtModuleChain" Text="—" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Module" Foreground="#888888" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Connection detail / failure reason — full width, wraps instead of
                         overflowing the device-chain row. -->
                    <TextBlock x:Name="txtStatusDetail" Foreground="#E0A800" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

                    <!-- Shown when the attached wheel resolves to a registered SimHub
                         device the user hasn't added yet — LED/display output never
                         starts without the device. Laid out as a callout bar: glyph,
                         headline + muted detail, action button; left-anchored and
                         width-capped so it doesn't sprawl on wide windows. Texts and
                         button visibility are driven by UpdateAddDevicePrompt. -->
                    <Border x:Name="borderAddDeviceAlert" Visibility="Collapsed"
                            Background="#1AFFCC00" BorderBrush="#FFCC00" BorderThickness="1"
                            CornerRadius="4" Padding="12,10" Margin="0,0,0,12"
                            HorizontalAlignment="Left" MaxWidth="700">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#x26A0;" FontSize="18" Foreground="#FFCC00"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtAddDeviceTitle" Foreground="#FFEEBB" FontSize="12"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="txtAddDeviceDetail" Foreground="#FFEEBB" Opacity="0.7"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <styles:SHButtonPrimary Grid.Column="2" x:Name="btnAddDevice" Click="BtnAddDevice_Click"
                                                    VerticalAlignment="Center" Margin="16,0,0,0"
                                                    ToolTip="Add the detected wheel or hub/module combo to SimHub's device list. SimHub switches to its Devices page once added.">
                                Add to SimHub
                            </styles:SHButtonPrimary>
                        </Grid>
                    </Border>

                    <!-- Capabilities — styled like a chain node (value + caption) -->
                    <StackPanel Margin="0,0,0,2">
                        <TextBlock x:Name="txtCapabilities" Text="—" TextWrapping="Wrap" />
                        <TextBlock Text="Capabilities" Foreground="#888888" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <styles:SHButtonPrimary x:Name="btnReconnect" Click="BtnReconnect_Click" HorizontalAlignment="Left">
                            Reconnect
                        </styles:SHButtonPrimary>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#AAAAAA" FontSize="11">
                          <Hyperlink Click="BtnCopyDiagnostics_Click"
                                      Foreground="#4FC3F7" TextDecorations="None"
                                      ToolTip="Copy a detailed, read-only detection report to the clipboard for pasting into a GitHub issue">
                              Copy Debug Info
                          </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </styles:SHSection>

            <!-- Wheel Profile -->
            <styles:SHSection Title="WHEEL PROFILE" ShowSeparator="True">
                <StackPanel>
                    <TextBlock x:Name="txtProfileHint" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Connect a wheel to manage profiles." />
                    <!-- Shown when the active profile is unverified (not tested on hardware) -->
                    <Border x:Name="borderUnverifiedAlert" Visibility="Collapsed"
                            Background="#1AFFCC00" BorderBrush="#FFCC00" BorderThickness="1"
                            CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock Foreground="#FFEEBB" FontSize="12" TextWrapping="Wrap">
                            &#x26A0;  This wheel profile has not been tested on hardware. You may experience issues.
                            <Hyperlink Click="BtnReportIssue_Click"
                                       Foreground="#4FC3F7" TextDecorations="None"
                                       ToolTip="Open a GitHub issue to share feedback on this profile">
                                Share feedback on GitHub
                            </Hyperlink>
                        </TextBlock>
                    </Border>

                    <StackPanel x:Name="panelProfilePicker" Visibility="Collapsed">
                        <!-- Shown when the connected wheel has no matching profile -->
                        <Border x:Name="borderNoProfileAlert" Visibility="Collapsed"
                                Background="#1A4488CC" BorderBrush="#4488CC" BorderThickness="1"
                                CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                            <TextBlock Foreground="#AADDFF" FontSize="12" TextWrapping="Wrap">
                                &#x2139;  This wheel doesn't have a FanaBridge profile yet. Click <Bold>New Profile Wizard</Bold> to create one — it only takes a few minutes.
                            </TextBlock>
                        </Border>
                        <!-- Shown when multiple profiles match (built-in + user override) -->
                        <TextBlock x:Name="txtMultipleProfilesHint" Visibility="Collapsed"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Multiple profiles available:" />
                        <StackPanel x:Name="panelProfileCombo" Orientation="Horizontal">
                            <ComboBox x:Name="cboProfile" Width="420"
                                      SelectionChanged="CboProfile_SelectionChanged" />
                            <Button x:Name="btnDeleteProfile" Click="BtnDeleteProfile_Click"
                                    IsEnabled="False" Margin="6,0,0,0" Padding="6,4"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Foreground="#FF6666" FontSize="14" Cursor="Hand"
                                    Content="&#x1F5D1;" ToolTip="Delete the selected custom profile" />
                        </StackPanel>
                        <TextBlock x:Name="txtProfileSource" Text="" Margin="0,4,0,0"
                                   Foreground="#AAAAAA" FontSize="11" />
                        <Border x:Name="txtContributeProfile" Visibility="Collapsed"
                                Background="#1A4488CC" BorderBrush="#4488CC" BorderThickness="1"
                                CornerRadius="4" Padding="10,6" Margin="0,10,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock Foreground="#AADDFF" FontSize="12">
                                &#x2139;  This profile could help others!
                                <Hyperlink Click="BtnContributeProfile_Click"
                                           Foreground="#4FC3F7" TextDecorations="None"
                                           ToolTip="Open a pre-filled GitHub issue to share this profile">
                                    Share it on GitHub
                                </Hyperlink>
                            </TextBlock>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    VerticalAlignment="Center">
                            <styles:SHButtonPrimary x:Name="btnCreateProfile" Click="BtnCreateProfile_Click"
                                                    HorizontalAlignment="Left"
                                                    ToolTip="Probe your wheel's hardware to create a new profile">
                                New Profile Wizard
                            </styles:SHButtonPrimary>
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="#AAAAAA" FontSize="11">
                                <Hyperlink Click="BtnOpenProfilesFolder_Click"
                                           Foreground="#4FC3F7" TextDecorations="None"
                                           ToolTip="Open the folder containing custom profile files">
                                    Open Profiles Folder
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="txtRestartNotice" Visibility="Collapsed"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="#FFDDAA" FontStyle="Italic"
                                   Text="&#x26A0;  LED and display output is active immediately. Restart SimHub to update the device name and LED editor slot count." />
                    </StackPanel>
                </StackPanel>
            </styles:SHSection>

            <!-- Quick Display Test -->
            <styles:SHSection Title="DISPLAY TEST" ShowSeparator="True">
                <StackPanel>
                    <TextBlock Text="Send a string to the 3-digit 7-segment display. Longer strings scroll automatically." Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="txtDisplayTest" Width="200" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                        <styles:SHButtonPrimary x:Name="btnSendDisplay" Click="BtnSendDisplay_Click" Content="Send" VerticalAlignment="Center" />
                        <styles:SHButtonPrimary x:Name="btnStopScroll" Click="BtnStopScroll_Click" Margin="8,0,0,0" Visibility="Collapsed" Content="Stop" VerticalAlignment="Center" />
                        <styles:SHButtonPrimary x:Name="btnClearDisplay" Click="BtnClearDisplay_Click" Margin="8,0,0,0" Content="Clear" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Scroll speed (ms): " VerticalAlignment="Center" />
                        <TextBox x:Name="txtScrollSpeed" Width="50" Text="250" VerticalContentAlignment="Center" LostFocus="TxtScrollSpeed_LostFocus" />
                    </StackPanel>
                </StackPanel>
            </styles:SHSection>

            <!-- Experimental Features -->
            <styles:SHSection Title="EXPERIMENTAL FEATURES" ShowSeparator="True">
                <StackPanel>
                    <CheckBox x:Name="chkEnableTuning"
                              Content="Enable tuning features (encoder mode, etc.)"
                              IsChecked="{Binding EnableTuning}"
                              Checked="ChkEnableTuning_Changed" Unchecked="ChkEnableTuning_Changed" />
                    <TextBlock Text="Tuning writes directly to device firmware settings via USB HID. Disabled by default."
                               TextWrapping="Wrap" Margin="20,4,0,0" Opacity="0.6" FontSize="11" />

                    <CheckBox x:Name="chkEnableControlMapperIntegration"
                              Margin="0,12,0,0"
                              Content="Control Mapper Integration"
                              IsChecked="{Binding EnableControlMapperIntegration}"
                              Checked="ChkEnableControlMapperIntegration_Changed"
                              Unchecked="ChkEnableControlMapperIntegration_Changed" />
                    <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" Opacity="0.6" FontSize="11"
                               Text="Supplies FanaBridge's wheel identity to SimHub's Control Mapper, extending its per-rim recognition to Fanatec wheels and bases SimHub can't identify on its own (Podium DD, newer wheels). Requires Control Mapper's &quot;Recognize Individual Wheels&quot; setting." />
                    <TextBlock x:Name="txtControlMapperStatus"
                               TextWrapping="Wrap" Margin="20,4,0,0" FontSize="11"
                               Visibility="Collapsed" />
                </StackPanel>
            </styles:SHSection>

            <!-- About -->
            <styles:SHSection Title="ABOUT" ShowSeparator="False">
                <StackPanel>
                    <TextBlock x:Name="txtPluginVersion" Text="FanaBridge" FontSize="14" FontWeight="SemiBold" Margin="0,2" />
                    <TextBlock x:Name="txtBuildInfo" Text="—" Foreground="#888" Margin="0,2" />
                    <TextBlock Margin="0,2">
                        <Hyperlink NavigateUri="https://github.com/kelchm/FanaBridge" RequestNavigate="RepoLink_RequestNavigate">
                            github.com/kelchm/FanaBridge
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </styles:SHSection>

        </StackPanel>
    </ScrollViewer>
</UserControl>
