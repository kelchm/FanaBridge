  ],
  "patternRules": [
    {
      "match": "^InputStatus\\.ControlMapperPlugin\\.FNKey0*(\\d+)Activated$",
      "aliasPattern": "FN layer $1",
      "unit": null,
      "notes": "Covers FNKey01Activated through FNKey40Activated. $1 is the layer number with any leading zero dropped, so FNKey01Activated reads \"FN layer 1\" and FNKey40Activated reads \"FN layer 40\"."
    }
  ],
  "prefixRules": [
    {
      "prefix": "InputStatus.ControlMapperPlugin.",
      "aliasPattern": "$1",
      "unit": null,
      "notes": "A mapped control. $1 is everything after the prefix, kept whole (role names are user-authored and may contain spaces or dots), so \"Up Shift\" reads as \"Up Shift\". Pattern rules are matched before prefix rules so the FN layer keys do not fall through to this one."
    }
  ]
}
