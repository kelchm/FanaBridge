<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>FanaBridge</RootNamespace>
    <AssemblyName>FanaBridge</AssemblyName>
    <Description>Fanatec wheel LED and display control plugin for SimHub</Description>
    <Product>FanaBridge</Product>
    <Copyright>Copyright (c) 2026</Copyright>
    <ProjectGuid>{77D40755-B5B5-4C53-BD35-1CDEF35AF422}</ProjectGuid>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <UseWPF>true</UseWPF>
    <DebugType>embedded</DebugType>
    <!-- Enables the shared CopyToSimHub install target (Directory.Build.targets). -->
    <IsSimHubPlugin>true</IsSimHubPlugin>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SimHub-free device stack (HID transport, protocol, profiles) and
         the self-updater. Private=true (default) so both DLLs land in this
         project's bin, where MergePlugin folds them into the single merged
         FanaBridge.dll that packaging and the install target ship. -->
    <ProjectReference Include="..\FanaBridge.Core\FanaBridge.Core.csproj" />
    <ProjectReference Include="..\FanaBridge.Updater\FanaBridge.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provides .NET Framework 4.8 reference assemblies for builds without VS -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Package-time merge tool (see the MergePlugin target): end users get a
         single FanaBridge.dll; the two-assembly split exists for development. -->
    <PackageReference Include="ILRepack" Version="2.0.45" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Framework assembly (self-updater HTTP client); not an external dependency. -->
    <Reference Include="System.Net.Http" />
    <!-- SimHub references (from install directory) -->
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubDir)GameReaderCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>$(SimHubDir)SimHub.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubDir)SimHub.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WoteverCommon">
      <HintPath>$(SimHubDir)WoteverCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>$(SimHubDir)MahApps.Metro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MahApps.Metro.IconPacks.Material">
      <HintPath>$(SimHubDir)MahApps.Metro.IconPacks.Material.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(SimHubDir)log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SimHubDir)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- HidSharp + SharpDX are used solely by Diagnostics/DiagnosticsReport.cs
         (HID inventory + DirectInput capture in the debug report). -->
    <Reference Include="HidSharp">
      <HintPath>$(SimHubDir)HidSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BA63Driver">
      <HintPath>$(SimHubDir)BA63Driver.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX">
      <HintPath>$(SimHubDir)SharpDX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX.DirectInput">
      <HintPath>$(SimHubDir)SharpDX.DirectInput.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\plugin-icon.png" />
  </ItemGroup>

  <!-- ── Device logo processing ──────────────────────────────────────
       Automatically runs process-device-logos.ps1 when source images
       are newer than processed output. Skips if ImageMagick isn't
       available (uses source images as-is via fallback copy). -->
  <ItemGroup>
    <SourceDeviceLogos Include="Resources\DeviceLogos\*.png" />
  </ItemGroup>

  <Target Name="ProcessDeviceLogos" BeforeTargets="CopyDeviceLogos;Build" Inputs="@(SourceDeviceLogos)" Outputs="@(SourceDeviceLogos->'Resources\DeviceLogos\processed\%(Filename)%(Extension)')">
    <Exec Command="magick --version" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="MagickExitCode" />
    </Exec>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\..\scripts\process-device-logos.ps1&quot;" Condition="'$(MagickExitCode)' == '0'" />
    <!-- Fallback: if no ImageMagick, just copy source images to processed/ -->
    <MakeDir Directories="Resources\DeviceLogos\processed" Condition="'$(MagickExitCode)' != '0'" />
    <Copy SourceFiles="@(SourceDeviceLogos)" DestinationFolder="Resources\DeviceLogos\processed" SkipUnchangedFiles="true" Condition="'$(MagickExitCode)' != '0'" />
  </Target>

  <!-- ── Single-DLL packaging ──────────────────────────────────────────
       End users install exactly one FanaBridge.dll, as before the project
       split — the satellite assemblies (Core, Updater) exist for development
       (compiler-enforced layering), and ILRepack folds them into the plugin
       at package/install time. Output goes to bin\<cfg>\merged\ so the
       normal multi-assembly build outputs (which the test project consumes)
       are never touched. Runs when packaging (-p:MergePlugin=true) or
       installing (-p:InstallToSimHub=true). -->
  <Target Name="MergePlugin" AfterTargets="Build"
          Condition="'$(MergePlugin)' == 'true' or '$(InstallToSimHub)' == 'true'"
          Inputs="$(TargetPath);$(TargetDir)FanaBridge.Core.dll;$(TargetDir)FanaBridge.Updater.dll"
          Outputs="$(TargetDir)merged\$(TargetFileName)">
    <MakeDir Directories="$(TargetDir)merged" />
    <Exec Command="&quot;$(PkgILRepack)\tools\ILRepack.exe&quot; /out:&quot;$(TargetDir)merged\$(TargetFileName)&quot; /lib:&quot;$(SimHubDir)\&quot; /targetplatform:v4 &quot;$(TargetPath)&quot; &quot;$(TargetDir)FanaBridge.Core.dll&quot; &quot;$(TargetDir)FanaBridge.Updater.dll&quot;" />
    <Message Importance="high" Text="Merged FanaBridge.Core + FanaBridge.Updater into $(TargetDir)merged\$(TargetFileName)" />
  </Target>

  <!-- ── Local dev install (device logos) ──────────────────────────────
       Copies the processed device logos into the local SimHub install.
       The merged plugin DLL is installed by the shared CopyToSimHub target
       in Directory.Build.targets. Only runs when InstallToSimHub=true:

         dotnet build -p:InstallToSimHub=true

       Default builds just compile — no file locking issues. -->
  <Target Name="CopyDeviceLogos" AfterTargets="Build" Condition="'$(InstallToSimHub)' == 'true'" DependsOnTargets="ProcessDeviceLogos">
    <ItemGroup>
      <DeviceLogoFiles Include="Resources\DeviceLogos\processed\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(DeviceLogoFiles)" DestinationFolder="$(SimHubDir)DevicesLogos" SkipUnchangedFiles="true" />
  </Target>

</Project>
