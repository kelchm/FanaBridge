<UserControl x:Class="FanaBridge.UI.Display.DisplayAddPageV2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FanaBridge.UI.Display"
             xmlns:shared="clr-namespace:FanaBridge.UI.Display.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FanaBridge;component/UI/Display/Shared/DisplayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
      Add-a-page flow (board 5h). Plain door LIVE; setup porch INERT (D20 —
      SpokeArrivingLater; manifest family does not exist). Copy from DisplayCopy;
      writes via DisplayConfigV2EditSession.
    -->
    <DockPanel LastChildFill="True" Margin="0">

            <!-- ViewHeaderRow: ‹ Overview / actual origin / Add -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostBack}" Click="BackOverview_Click">
                    <TextBlock Style="{StaticResource GhostBackGlyph}" />
                </Button>
                <TextBlock Text="/" Foreground="#5A5A5C" Margin="6,0" VerticalAlignment="Center" FontSize="14" />
                <Button x:Name="btnPriorityCrumb" Background="Transparent" BorderThickness="0"
                        Padding="0" Cursor="Hand" Click="BackPriority_Click" VerticalAlignment="Center">
                    <TextBlock x:Name="txtPriorityCrumb" FontSize="15" Foreground="#9FBDD4"
                               VerticalAlignment="Center" />
                </Button>
                <TextBlock Text="/" Foreground="#5A5A5C" Margin="6,0" VerticalAlignment="Center" FontSize="14" />
                <TextBlock x:Name="txtTitle" FontSize="17" FontWeight="SemiBold"
                           Foreground="#F0F0F0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtSurfaceWord" FontWeight="SemiBold"
                               Foreground="#EAEAEA" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtDivider" Foreground="#5A5A5C" Margin="8,0"
                               VerticalAlignment="Center" FontSize="12" />
                    <Ellipse x:Name="dotSituation" Width="9" Height="9"
                             Fill="#35E06A" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="txtSituation" FontSize="12" Foreground="#8FBF9A"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Border Background="#232325" BorderBrush="#454547" BorderThickness="1"
                        Padding="8,4" Margin="0,5,0,3">
                    <DockPanel>
                        <TextBlock x:Name="txtProfileChevron" DockPanel.Dock="Right"
                                   Foreground="#7A7A7A" Margin="12,0,0,0" />
                        <TextBlock x:Name="txtProfileName" Foreground="#D8D8D8"
                                   FontSize="11.5" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnProfilesManager" IsEnabled="False"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#9FBDD4" Padding="3,1" />
                    <Button x:Name="btnEditProfile" IsEnabled="False"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#9FBDD4" Padding="3,1" />
                    <Button x:Name="btnCloneProfile" IsEnabled="False"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#9FBDD4" Padding="3,1" />
                    <Button x:Name="btnNewProfile" IsEnabled="False"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#9FBDD4" Padding="3,1" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Conflict banner -->
        <Border x:Name="bannerConflict" DockPanel.Dock="Top" Background="#3A2A1A"
                BorderBrush="#C9A95F" BorderThickness="1" Padding="10,8" Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="txtConflict" FontSize="12.5" Foreground="#E8D5A0"
                       TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- [C1] Setup porch — INERT (D20) -->
            <StackPanel Grid.Column="0" Opacity="0.55">
                <TextBlock x:Name="txtSetupLabel" FontSize="9.5" FontFamily="Consolas"
                           Foreground="#7C7C7E" Margin="0,0,0,8" />
                <TextBox x:Name="txtSetupSearch" IsEnabled="False"
                         Padding="6,5" FontSize="12.5" Background="#232325"
                         Foreground="#E6E6E6" BorderBrush="#5A5A5C" Margin="0,0,0,8" />
                <Border Background="#2B2B2D" CornerRadius="3" Padding="12,14" MinHeight="120">
                    <TextBlock x:Name="txtSetupNote" FontSize="12.5" Foreground="#9FBDD4"
                               TextWrapping="Wrap" LineHeight="18" />
                </Border>
            </StackPanel>

            <!-- [C2] Configure / create-page form -->
            <StackPanel Grid.Column="2" x:Name="panelConfigure">
                <TextBlock x:Name="txtConfigureHint" FontSize="12.5" Foreground="#8F8F8F"
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <!-- Page creation form (plain door A page) -->
                <StackPanel x:Name="panelPageForm" Visibility="Collapsed">
                    <TextBlock x:Name="txtPageFormTitle" FontSize="13" FontWeight="SemiBold"
                               Foreground="#EAEAEA" Margin="0,0,0,10" />
                    <TextBlock x:Name="txtKindLabel" FontSize="11" Foreground="#8F8F8F" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="radItm" GroupName="pageKind" Margin="0,0,16,0"
                                     Foreground="#E6E6E6" Checked="PageKind_Changed" />
                        <RadioButton x:Name="radHosted" GroupName="pageKind"
                                     Foreground="#E6E6E6" Checked="PageKind_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="panelItmPick" Margin="0,0,0,10">
                        <Button x:Name="btnPickItm" Padding="10,6" HorizontalAlignment="Left"
                                Background="#2C2C2E" BorderBrush="#545456" BorderThickness="1"
                                Foreground="#E6E6E6" FontSize="12.5" Cursor="Hand"
                                Click="PickItm_Click" />
                    </StackPanel>
                    <TextBlock x:Name="txtNameLabel" FontSize="11" Foreground="#8F8F8F" Margin="0,0,0,4" />
                    <TextBox x:Name="txtPageName" Padding="6,5" FontSize="12.5"
                             Background="#232325" Foreground="#E6E6E6" BorderBrush="#5A5A5C"
                             Margin="0,0,0,10" />
                    <CheckBox x:Name="chkAddRotation" Foreground="#C8C8C8" FontSize="12.5"
                              Margin="0,0,0,10" />
                    <TextBlock x:Name="txtPageAddedNote" FontSize="11.5" Foreground="#7A7A7A"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnFormCancel" Padding="12,6" Margin="0,0,8,0"
                                Background="#2C2C2E" BorderBrush="#545456" BorderThickness="1"
                                Foreground="#C8C8C8" Click="FormCancel_Click" />
                        <Button x:Name="btnFormCreate" Padding="14,6"
                                Background="#187FAD" BorderThickness="0"
                                Foreground="#FFFFFF" FontWeight="SemiBold"
                                Click="FormCreate_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- [C3] Plain door -->
            <Border Grid.Column="4" BorderBrush="#3A3A3C" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="txtDoorLabel" FontSize="9.5" FontFamily="Consolas"
                               Foreground="#7C7C7E" Margin="0,0,0,6" />
                    <TextBlock x:Name="txtDoorNote" FontSize="11.5" Foreground="#7A7A7A"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel x:Name="panelDoors" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ITM page picker (5n shell minus screens/playlists) -->
        <Popup x:Name="popupItmPicker" Placement="MousePoint" StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#2B2B2D" BorderBrush="#545456" BorderThickness="1"
                    Width="360" MaxHeight="360" Padding="0,8,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                    <StackPanel>
                        <TextBlock x:Name="txtItmPickerEmpty"
                                   Margin="12,8"
                                   FontSize="12.5"
                                   Foreground="#9A9A9C"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="listItmChoices" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
