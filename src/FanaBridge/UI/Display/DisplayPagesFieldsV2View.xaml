<UserControl x:Class="FanaBridge.UI.Display.DisplayPagesFieldsV2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FanaBridge.UI.Display"
             xmlns:shared="clr-namespace:FanaBridge.UI.Display.Shared"
             PreviewKeyDown="Root_PreviewKeyDown"
             SizeChanged="Root_SizeChanged"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FanaBridge;component/UI/Display/Shared/DisplayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
      Pages & Fields (boards 5c/5d/5g/5p + 8c field filter).
      D1–D15 / F1–F10 sanctioned divergences — see e9-final-wave-digest §DIVERGENCES.
      Copy from DisplayCopy; writes via DisplayConfigV2EditSession.
    -->
    <DockPanel LastChildFill="True">

        <!-- ViewHeaderRow [B] -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostBack}" Click="Back_Click">
                    <TextBlock Style="{StaticResource GhostBackGlyph}" />
                </Button>
                <TextBlock Text="/" Foreground="#5A5A5C" Margin="6,0" VerticalAlignment="Center" FontSize="14" />
                <TextBlock x:Name="txtTitle" FontSize="17" FontWeight="SemiBold"
                           Foreground="#F0F0F0" VerticalAlignment="Center" />
                <!-- D15: third breadcrumb leaf only while 5g modal is open -->
                <TextBlock x:Name="txtFormLeafSep" Text="/" Foreground="#5A5A5C" Margin="6,0"
                           VerticalAlignment="Center" FontSize="14" Visibility="Collapsed" />
                <TextBlock x:Name="txtFormLeaf" FontSize="17" FontWeight="SemiBold"
                           Foreground="#F0F0F0" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="txtSurfaceWord" FontWeight="SemiBold"
                           Foreground="#EAEAEA" FontSize="12.5" VerticalAlignment="Center" />
                <TextBlock x:Name="txtDivider" Foreground="#5A5A5C" Margin="8,0"
                           VerticalAlignment="Center" FontSize="12" />
                <Ellipse x:Name="dotSituation" Width="9" Height="9"
                         Fill="#35E06A" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="txtSituation" FontSize="12" Foreground="#8FBF9A"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Conflict banner -->
        <Border x:Name="bannerConflict" DockPanel.Dock="Top" Background="#3A2A1A"
                BorderBrush="#C9A95F" BorderThickness="1" Padding="10,8" Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="txtConflict" FontSize="12.5" Foreground="#E8D5A0"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Focus-clear announcement (D10) -->
        <Border x:Name="bannerFocusClear" DockPanel.Dock="Top" Background="#2A2A2C"
                BorderBrush="#454547" BorderThickness="1" Padding="10,6" Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="txtFocusClear" FontSize="12.5" Foreground="#C8C8C8"
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock x:Name="txtModeOffEmpty" DockPanel.Dock="Top" FontSize="13"
                   Foreground="#8F8F8F" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="Collapsed" />

        <!-- Scroll lives ONLY in the field collection (8c item 2); chrome stays fixed. -->
        <StackPanel x:Name="panelContent">

                <!-- Page strip [C] -->
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="btnRotationMenu" DockPanel.Dock="Right"
                            Content="⋯" FontSize="14" Padding="8,4" Margin="8,0,0,0"
                            Background="#232325" BorderBrush="#454547" BorderThickness="1"
                            Foreground="#C8C8C8" Click="RotationMenu_Click"
                            VerticalAlignment="Center" />
                    <WrapPanel x:Name="panelPageStrip" Orientation="Horizontal" />
                </DockPanel>
                <TextBlock x:Name="txtStripNote" FontSize="11.5" Foreground="#7A7A7A"
                           TextWrapping="Wrap" Margin="0,0,0,14" />

                <!-- BodyGrid [D] -->
                <Grid x:Name="gridBody" MinHeight="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="496" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0">
                        <!-- PreviewCard -->
                        <Border Background="#2B2B2D" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Width="496" MinHeight="124" Background="#000000"
                                      MouseLeftButtonDown="PreviewChrome_Click">
                                    <!-- ITM pages: the digital twin (values + suffixes,
                                         interactive field selection). Hosted pages: the
                                         3-character segment face — the surface their
                                         content actually writes. -->
                                    <ui:ItmDisplayMirror x:Name="displayMirror" />
                                    <ContentControl x:Name="hostSegmentPreview"
                                                    Visibility="Collapsed"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,16" />
                                    <TextBlock x:Name="txtPreviewWatermark"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Margin="0,4,6,0" FontSize="8" FontFamily="Consolas"
                                               Foreground="#4A4A4C" IsHitTestVisible="False" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="txtPreviewCaption" FontSize="12"
                                               Foreground="#9A9A9C" TextWrapping="Wrap"
                                               MaxWidth="400" />
                                    <Border x:Name="badgeFromCatalog" Background="#3A3020"
                                            BorderBrush="#5A4A32" BorderThickness="1"
                                            CornerRadius="2" Padding="5,1" Margin="8,0,0,0"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="txtFromCatalog" FontSize="9.5"
                                                   FontFamily="Consolas" Foreground="#C9A95F" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- WHERE THIS APPLIES -->
                        <Border Background="#232325" CornerRadius="3" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="txtWhereLabel" FontSize="9.5" FontFamily="Consolas"
                                           Foreground="#7C7C7E" Margin="0,0,0,4" />
                                <TextBlock x:Name="txtWhereBody" FontSize="12.5" Foreground="#C8C8C8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- THIS WHEEL (focused field envelope) -->
                        <Border x:Name="cardThisWheel" Background="#232325" CornerRadius="3"
                                Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="txtThisWheelLabel" FontSize="9.5"
                                           FontFamily="Consolas" Foreground="#7C7C7E" Margin="0,0,0,4" />
                                <TextBlock x:Name="txtThisWheelBody" FontSize="12.5"
                                           Foreground="#C8C8C8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- ENTRYPOINTS TO THIS PAGE -->
                        <StackPanel Margin="0,0,0,10">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="txtEpLabel" FontSize="9.5" FontFamily="Consolas"
                                           Foreground="#7C7C7E" VerticalAlignment="Center" />
                                <TextBlock x:Name="txtEpCount" FontSize="11.5" Foreground="#8F8F8F"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Hyperlink x:Name="linkPriority" Style="{StaticResource Link}"
                                               Click="Priority_Click" />
                                </TextBlock>
                            </DockPanel>
                            <StackPanel x:Name="panelEntrypoints" />
                            <TextBlock x:Name="txtEpFoot" FontSize="11.5" Foreground="#7A7A7A"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right column: field collection (8c rebuild) — sole scroll region -->
                    <DockPanel Grid.Column="2" x:Name="dockFieldRegion">
                        <!-- Sticky filter state line (only while focused) — D4 -->
                        <Border x:Name="barFilterState" DockPanel.Dock="Top"
                                Background="#1E2022" Padding="8,6" Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <TextBlock x:Name="txtFilterState" FontSize="12.5" Foreground="#C8C8C8"
                                       TextWrapping="Wrap">
                                <Run x:Name="runFilterText" />
                                <Hyperlink x:Name="linkShowAll" Style="{StaticResource Link}"
                                           Click="ShowAllFields_Click" />
                            </TextBlock>
                        </Border>

                        <ScrollViewer x:Name="scrollFieldCollection"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="panelFieldCollection" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- THIS PAGE card [E] -->
                <Border x:Name="cardThisPage" Background="#232325" CornerRadius="3"
                        Padding="12,10" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="txtThisPageLabel" FontSize="9.5" FontFamily="Consolas"
                                   Foreground="#7C7C7E" Margin="0,0,0,4" />
                        <TextBlock x:Name="txtThisPageBody" FontSize="12.5" Foreground="#C8C8C8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
        </StackPanel>

        <!-- 5g Override form modal -->
        <Popup x:Name="popupOverride" AllowsTransparency="True" StaysOpen="True"
               Placement="Center" PopupAnimation="Fade">
            <Border x:Name="chromeOverrideModal"
                    Background="#252525" BorderBrush="#545456" BorderThickness="1"
                    Width="560" Padding="0" MaxHeight="640">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2B2B2D" Padding="14,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="14"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#A0A0A0" Padding="8,2"
                                    Click="OverrideCancel_Click" Cursor="Hand" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtOvTitlePrefix" FontSize="14"
                                           Foreground="#C8C8C8" VerticalAlignment="Center" />
                                <Border Background="#1E2F3D" CornerRadius="2" Padding="6,2"
                                        Margin="8,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtOvPageBadge" FontSize="11"
                                               FontFamily="Consolas" Foreground="#9FBDD4" />
                                </Border>
                                <TextBlock x:Name="txtOvFieldName" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#F0F0F0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="#3A3A3C"
                            BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button x:Name="btnOvDelete" DockPanel.Dock="Left"
                                    Padding="12,6" Background="Transparent"
                                    BorderBrush="#8B3A3A" BorderThickness="1"
                                    Foreground="#E07070" Click="OverrideDelete_Click" />
                            <Button x:Name="btnOvSplit" DockPanel.Dock="Left"
                                    Padding="12,6" Margin="8,0,0,0"
                                    Background="#232325" BorderBrush="#545456"
                                    BorderThickness="1" Foreground="#9FBDD4"
                                    Click="OverrideSplit_Click" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnOvCancel" Padding="12,6" Margin="0,0,8,0"
                                        Background="#232325" BorderBrush="#454547"
                                        BorderThickness="1" Foreground="#C8C8C8"
                                        Click="OverrideCancel_Click" />
                                <Button x:Name="btnOvSave" Padding="14,6"
                                        Background="#187FAD" BorderThickness="0"
                                        Foreground="#FFFFFF" FontWeight="SemiBold"
                                        Click="OverrideSave_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="scrollOverrideBody"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="txtWhatItWrites" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="#7C7C7E" Margin="0,0,0,6" />
                            <CheckBox x:Name="chkOvValue" Margin="0,0,0,4"
                                      Foreground="#C8C8C8" FontSize="12.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="chkOvSuffix" Foreground="#C8C8C8"
                                          FontSize="12.5" VerticalAlignment="Center" />
                                <TextBox x:Name="txtOvSuffixContent" Width="98" Margin="10,0,0,0"
                                         FontFamily="Consolas" FontSize="13"
                                         Background="#1A1A1C" Foreground="#F0F0F0"
                                         BorderBrush="#454547" Padding="4,2" />
                            </StackPanel>
                            <StackPanel x:Name="panelOvAlign" Margin="40,0,0,8" Visibility="Collapsed">
                                <TextBlock x:Name="txtAlignLabel" FontSize="12" Foreground="#9A9A9C"
                                           Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="radAlignLeft" GroupName="ovAlign"
                                                 Margin="0,0,12,0" Foreground="#C8C8C8" />
                                    <RadioButton x:Name="radAlignRight" GroupName="ovAlign"
                                                 Foreground="#C8C8C8" />
                                    <TextBlock x:Name="txtAlignWidth" FontSize="11.5"
                                               Foreground="#7A7A7A" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="txtValueThenSuffix" FontSize="11.5"
                                       Foreground="#7A7A7A" Margin="0,0,0,12" TextWrapping="Wrap" />

                            <TextBlock x:Name="txtWhen" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="#7C7C7E" Margin="0,0,0,6" />
                            <shared:SegmentedControl x:Name="segOvSource" Margin="0,0,0,8" />
                            <Border Background="#1A1A1C" BorderBrush="#454547" BorderThickness="1"
                                    Padding="8,6" Margin="0,0,0,8" Cursor="Hand"
                                    MouseLeftButtonDown="PropertyRow_Click">
                                <DockPanel>
                                    <TextBlock x:Name="txtOvChevron" DockPanel.Dock="Right"
                                               Foreground="#7A7A7A" VerticalAlignment="Center" />
                                    <TextBlock x:Name="txtOvSourcePath" FontFamily="Consolas"
                                               FontSize="12.5" Foreground="#C8C8C8"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox x:Name="txtOvValue" Width="80" FontSize="12.5"
                                         Background="#1A1A1C" Foreground="#F0F0F0"
                                         BorderBrush="#454547" Padding="4,2" />
                                <ComboBox x:Name="cmbOvOperator" Width="120" Margin="8,0,0,0"
                                          FontSize="12.5" />
                            </StackPanel>

                            <!-- §7f: For-how-long (durations only) + Effect — the two
                                 rows the board omitted; owner-sanctioned extension. -->
                            <TextBlock x:Name="txtOvForHowLong" FontSize="9.5"
                                       FontFamily="Consolas" Foreground="#7C7C7E"
                                       Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <shared:SegmentedControl x:Name="segOvLifetime" />
                                <TextBox x:Name="txtOvSeconds" Width="44" FontSize="12.5"
                                         Margin="8,0,4,0" Background="#1A1A1C"
                                         Foreground="#F0F0F0" BorderBrush="#454547"
                                         Padding="4,2" VerticalAlignment="Center" />
                                <TextBlock x:Name="txtOvSecondsUnit" FontSize="12"
                                           Foreground="#9A9A9C" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="txtOvEffectLabel" FontSize="12"
                                       Foreground="#9A9A9C" Margin="0,0,0,4" />
                            <shared:SegmentedControl x:Name="segOvEffect" Margin="0,0,0,12" />

                            <Border Background="#2B3138" CornerRadius="3" Padding="10,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="chkOvEntrypoint" Foreground="#C8C8C8"
                                              FontSize="12.5" Margin="0,0,0,6" />
                                    <TextBlock x:Name="txtBringUpExplainer" FontSize="11.5"
                                               Foreground="#9FBDD4" TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <RadioButton x:Name="radBringUpPin" GroupName="ovBringUp"
                                                 Foreground="#C8C8C8" Margin="0,0,0,4" />
                                    <RadioButton x:Name="radBringUpVisit" GroupName="ovBringUp"
                                                 Foreground="#C8C8C8" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- 5i layer form (create = edit; the override form's idioms, layer shape) -->
        <Popup x:Name="popupLayer" AllowsTransparency="True" StaysOpen="True"
               Placement="Center" PopupAnimation="Fade">
            <Border Background="#252525" BorderBrush="#545456" BorderThickness="1"
                    Width="560" Padding="0" MaxHeight="640">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2B2B2D" Padding="14,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="14"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#A0A0A0" Padding="8,2"
                                    Click="LayerCancel_Click" Cursor="Hand" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtLayerTitlePrefix" FontSize="14"
                                           Foreground="#C8C8C8" VerticalAlignment="Center" />
                                <Border Background="#1E2F3D" CornerRadius="2" Padding="6,2"
                                        Margin="8,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtLayerPageBadge" FontSize="11"
                                               FontFamily="Consolas" Foreground="#9FBDD4" />
                                </Border>
                                <TextBlock x:Name="txtLayerPageName" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#F0F0F0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="#3A3A3C"
                            BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button x:Name="btnLayerDelete" DockPanel.Dock="Left"
                                    Padding="12,6" Background="Transparent"
                                    BorderBrush="#8B3A3A" BorderThickness="1"
                                    Foreground="#E07070" Click="LayerDelete_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnLayerCancel" Padding="12,6" Margin="0,0,8,0"
                                        Background="#232325" BorderBrush="#454547"
                                        BorderThickness="1" Foreground="#C8C8C8"
                                        Click="LayerCancel_Click" />
                                <Button x:Name="btnLayerSave" Padding="14,6"
                                        Background="#187FAD" BorderThickness="0"
                                        Foreground="#FFFFFF" FontWeight="SemiBold"
                                        Click="LayerSave_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="txtLayerWrites" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="#7C7C7E" Margin="0,0,0,6" />
                            <shared:SegmentedControl x:Name="segLayerContentKind" Margin="0,0,0,8" />
                            <StackPanel x:Name="panelLayerText" Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <TextBox x:Name="txtLayerContent" Width="98"
                                         FontFamily="Consolas" FontSize="13" MaxLength="3"
                                         CharacterCasing="Upper"
                                         Background="#1A1A1C" Foreground="#F0F0F0"
                                         BorderBrush="#454547" Padding="4,2" />
                                <TextBlock x:Name="txtLayerContentHint" FontSize="11.5"
                                           Foreground="#7A7A7A" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="panelLayerProperty" Background="#1A1A1C"
                                    BorderBrush="#454547" BorderThickness="1"
                                    Padding="8,6" Margin="0,0,0,8" Cursor="Hand"
                                    Visibility="Collapsed"
                                    MouseLeftButtonDown="LayerContentProperty_Click">
                                <DockPanel>
                                    <TextBlock x:Name="txtLayerPropChevron" DockPanel.Dock="Right"
                                               Foreground="#7A7A7A" VerticalAlignment="Center" />
                                    <TextBlock x:Name="txtLayerPropPath" FontFamily="Consolas"
                                               FontSize="12.5" Foreground="#C8C8C8"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="txtLayerEffectLabel" FontSize="12"
                                       Foreground="#9A9A9C" Margin="0,0,0,4" />
                            <shared:SegmentedControl x:Name="segLayerEffect" Margin="0,0,0,12" />

                            <TextBlock x:Name="txtLayerWhen" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="#7C7C7E" Margin="0,0,0,6" />
                            <Border Background="#1A1A1C" BorderBrush="#454547" BorderThickness="1"
                                    Padding="8,6" Margin="0,0,0,8" Cursor="Hand"
                                    MouseLeftButtonDown="LayerConditionProperty_Click">
                                <DockPanel>
                                    <TextBlock x:Name="txtLayerCondChevron" DockPanel.Dock="Right"
                                               Foreground="#7A7A7A" VerticalAlignment="Center" />
                                    <TextBlock x:Name="txtLayerCondPath" FontFamily="Consolas"
                                               FontSize="12.5" Foreground="#C8C8C8"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox x:Name="txtLayerCondValue" Width="80" FontSize="12.5"
                                         Background="#1A1A1C" Foreground="#F0F0F0"
                                         BorderBrush="#454547" Padding="4,2" />
                                <ComboBox x:Name="cmbLayerOperator" Width="120" Margin="8,0,0,0"
                                          FontSize="12.5" />
                            </StackPanel>

                            <TextBlock x:Name="txtLayerForHowLong" FontSize="9.5"
                                       FontFamily="Consolas" Foreground="#7C7C7E"
                                       Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <shared:SegmentedControl x:Name="segLayerLifetime" />
                                <TextBox x:Name="txtLayerSeconds" Width="44" FontSize="12.5"
                                         Margin="8,0,4,0" Background="#1A1A1C"
                                         Foreground="#F0F0F0" BorderBrush="#454547"
                                         Padding="4,2" VerticalAlignment="Center" />
                                <TextBlock x:Name="txtLayerSecondsUnit" FontSize="12"
                                           Foreground="#9A9A9C" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Background="#2B3138" CornerRadius="3" Padding="10,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="chkLayerEntrypoint" Foreground="#C8C8C8"
                                              FontSize="12.5" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- 5p Rotation dialog (D17: dialog primary) -->
        <Popup x:Name="popupRotation" AllowsTransparency="True" StaysOpen="True"
               Placement="Center" PopupAnimation="Fade">
            <Border x:Name="chromeRotationModal"
                    Background="#252525" BorderBrush="#545456" BorderThickness="1"
                    Width="420" Padding="0" MaxHeight="640">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2B2B2D" Padding="14,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="14"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#A0A0A0" Padding="8,2"
                                    Click="RotationCancel_Click" Cursor="Hand" />
                            <TextBlock x:Name="txtRotationTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F0F0F0" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="#3A3A3C"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnRotCancel" Padding="12,6" Margin="0,0,8,0"
                                    Background="#232325" BorderBrush="#454547"
                                    BorderThickness="1" Foreground="#C8C8C8"
                                    Click="RotationCancel_Click" />
                            <Button x:Name="btnRotSave" Padding="14,6"
                                    Background="#187FAD" BorderThickness="0"
                                    Foreground="#FFFFFF" FontWeight="SemiBold"
                                    Click="RotationSave_Click" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="scrollRotationBody"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="txtInRotation" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="#7C7C7E" Margin="0,0,0,6" />
                            <StackPanel x:Name="panelRotationIn" Margin="0,0,0,12" />
                            <TextBlock x:Name="txtNotInRotation" FontSize="9.5" FontFamily="Consolas"
                                       Foreground="#7C7C7E" Margin="0,0,0,6" />
                            <StackPanel x:Name="panelRotationOut" Margin="0,0,0,8" />
                            <TextBlock x:Name="txtDragNote" FontSize="11.5" Foreground="#7A7A7A"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
