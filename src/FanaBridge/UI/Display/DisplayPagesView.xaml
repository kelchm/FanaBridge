<UserControl x:Class="FanaBridge.UI.Display.DisplayPagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FanaBridge.UI.Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FanaBridge;component/UI/Display/Shared/DisplayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: ‹ back + title. No profile scope (profiles deferred). -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource GhostBack}" Click="Back_Click">
                <TextBlock Style="{StaticResource GhostBackGlyph}" />
            </Button>
            <TextBlock Text="ITM pages &amp; fields" Style="{StaticResource EditorTitle}" />
        </StackPanel>

        <!-- Page pills (built in code-behind from the device's ItmPageTable). -->
        <WrapPanel x:Name="panelPagePills" Margin="0,0,0,15" />

        <!-- Telemetry page: interactive twin | field inspector. -->
        <Grid x:Name="panelTelemetry" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Background="#0B0D0F" BorderBrush="#262C31" BorderThickness="1"
                        CornerRadius="8" Padding="11">
                    <ui:ItmDisplayMirror x:Name="pagesMirror" />
                </Border>
                <TextBlock Text="Click any field to remap it." FontSize="11.5"
                           Foreground="#7C7C7C" Margin="0,9,0,0" />
            </StackPanel>

            <!-- Field inspector card (contents rebuilt in code-behind). -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,17"
                    VerticalAlignment="Top">
                <StackPanel x:Name="panelInspector" />
            </Border>
        </Grid>

        <!-- Page 6 / Legacy delegation: mini 3-char face + Open Virtual pages. -->
        <Grid x:Name="panelLegacy" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Background="#0B0D0F" BorderBrush="#262C31" BorderThickness="1"
                        CornerRadius="8" Padding="11">
                    <Border Background="#000000" CornerRadius="5" MinHeight="90"
                            HorizontalAlignment="Stretch">
                        <ContentControl x:Name="hostPage6Face" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                    </Border>
                </Border>
                <TextBlock FontSize="11.5" Foreground="#7C7C7C" Margin="0,9,0,0"
                           TextWrapping="Wrap"
                           Text="ITM Page 6 is the free 3-character page — no fixed telemetry slots. What it shows comes from your Virtual pages." />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,17"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="No fields to map" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F0F0F0" Margin="0,0,0,8" />
                    <TextBlock FontSize="12.5" Foreground="#A0A0A0" TextWrapping="Wrap"
                               LineHeight="19" Margin="0,0,0,12"
                               Text="Unlike ITM pages 1–5, this page shows 3 free characters rather than fixed fields. What it displays (FN1, PIT, logo…) is set in the Virtual pages editor." />
                    <Button Content="Open Virtual pages →" Click="OpenLegacy_Click"
                            Padding="12,6" HorizontalAlignment="Left" Cursor="Hand" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
