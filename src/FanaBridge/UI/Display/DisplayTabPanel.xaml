<UserControl x:Class="FanaBridge.UI.Display.DisplayTabPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:FanaBridge.UI.Display"
             xmlns:shared="clr-namespace:FanaBridge.UI.Display.Shared"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FanaBridge;component/UI/Display/Shared/DisplayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">

            <!-- ── Header strip: DISPLAY MODE segmented toggle (ITM Overview, or any
                 wheel while control is Off so the user can leave Off) ── -->
            <StackPanel x:Name="panelModeHeader" Orientation="Horizontal" Margin="0,0,0,4"
                        Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="DISPLAY MODE" Style="{StaticResource KLabel}" Margin="0,0,0,5" />
                    <!-- The segments (ITM display / Legacy only / Off) are set and wired in Bind;
                         the chrome props reproduce the original SegmentButton look. Off uses
                         the amber selected brush via the per-segment overload. -->
                    <shared:SegmentedControl x:Name="segMode" HorizontalAlignment="Left"
                                             SegmentPadding="14,6" SegmentFontSize="12"
                                             OuterCornerRadius="4" />
                </StackPanel>
                <TextBlock x:Name="txtModeHint" FontSize="11.5" Foreground="#8F8F8F"
                           TextWrapping="Wrap" MaxWidth="280" Margin="16,0,0,2"
                           VerticalAlignment="Bottom" />
            </StackPanel>
            <Rectangle x:Name="lineModeHeader" Height="1" Fill="#3A3A3A" Margin="0,10,0,12"
                       Visibility="Collapsed" />

            <!-- Off card: mode-state shell content (NOT a _views navigation member). Shown
                 whenever DisplayControl is Off on any wheel; normal Overview/editor content
                 is collapsed while it is up. -->
            <StackPanel x:Name="panelOffCard" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" Margin="0,36,0,24">
                <Border Style="{StaticResource Card}" MaxWidth="540" Padding="26,28"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="DISPLAY MODE · OFF" Style="{StaticResource KLabel}"
                                   Margin="0,0,0,13" />
                        <TextBlock Text="FanaBridge isn't touching this display"
                                   FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F0"
                                   TextWrapping="Wrap" Margin="0,0,0,13" />
                        <TextBlock FontSize="13" Foreground="#A8A8A8" TextWrapping="Wrap"
                                   LineHeight="21" Margin="0,0,0,13"
                                   Text="ITM pages, triggers, and virtual pages are all paused — the game or the wheel's own firmware controls what shows. Use this for titles that drive the display themselves. Switch to ITM display or Legacy only to hand control back to FanaBridge." />
                        <Button x:Name="btnTurnDisplayOn" Content="Turn the display back on"
                                Click="TurnDisplayOn_Click" Padding="14,7"
                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                Cursor="Hand" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── Views (hub-and-spoke: Overview is the landing view; editors are
                 reached only through its contextual links and return via ‹) ── -->
            <Grid>

                <!-- Overview -->
                <StackPanel x:Name="viewOverview">

                    <!-- Live cards: current page + recent activity (ITM display mode only) -->
                    <StackPanel x:Name="panelItmLive">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Current page card: the live display mirror (digital twin),
                                 with the state caption in the header — the panel itself
                                 stays clean like the hardware — and the page caption below. -->
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="LIVE" Style="{StaticResource KLabel}" />
                                            <Ellipse Width="6" Height="6" Fill="#35E06A"
                                                     Margin="7,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="txtMirrorState" FontSize="10.5"
                                                       Foreground="#8F8F8F" Margin="9,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock FontSize="11.5" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <Hyperlink x:Name="btnEditPages" Style="{StaticResource Link}"
                                                       Click="EditPages_Click">Edit pages &amp; fields →</Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                    <Border BorderBrush="#262C31" BorderThickness="1"
                                            Margin="0,9,0,8" HorizontalAlignment="Center">
                                        <ui:ItmDisplayMirror x:Name="displayMirror" />
                                    </Border>
                                    <TextBlock x:Name="txtCurrentPage" FontSize="12.5"
                                               Foreground="#B0B0B0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Recent activity card -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource KLabel}"
                                               Margin="0,0,0,9" />
                                    <StackPanel x:Name="panelActivity" />
                                    <TextBlock x:Name="txtNoActivity" Text="No activity yet."
                                               FontSize="12" Foreground="#7A7A7A" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Display priority list (shared trigger table, Monitor mode) -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Display priority" FontSize="13.5"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="— top eligible trigger wins" FontSize="12"
                                           Foreground="#8F8F8F" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6" Fill="#45B85A" Margin="12,0,0,0"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="txtSituation" FontSize="11" Foreground="#8FBF9A"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock FontSize="11.5" HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Hyperlink x:Name="btnManageTriggers" Style="{StaticResource Link}"
                                           Click="ManageTriggers_Click">Edit triggers →</Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Rectangle Height="1" Fill="#3D3D3F" Margin="0,7,0,10" />
                        <shared:TriggerTableControl x:Name="monitorTable" />
                        <StackPanel x:Name="panelNoTriggers" Visibility="Collapsed" Margin="0,2,0,4">
                            <TextBlock Text="No triggers configured yet." FontSize="12"
                                       Foreground="#8F8F8F" Margin="0,0,0,8" />
                            <Button x:Name="btnAddTrigger" Content="＋ Add trigger"
                                    Click="OverviewAddTrigger_Click" Padding="12,4"
                                    HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Footer links to the remaining editors (design's "Also edit:" row) -->
                        <Rectangle Height="1" Fill="#333333" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Also edit:" FontSize="12" Foreground="#8F8F8F" />
                            <TextBlock FontSize="12" Margin="14,0,0,0">
                                <Hyperlink x:Name="btnAllTriggers" Style="{StaticResource Link}"
                                           Click="ManageTriggers_Click">All triggers &amp; idle behavior</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="·" FontSize="12" Foreground="#8F8F8F" Margin="10,0" />
                            <TextBlock FontSize="12">
                                <Hyperlink x:Name="btnEditLegacy" Style="{StaticResource Link}"
                                           Click="EditLegacy_Click">Legacy screens (Page 6)</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="·" FontSize="12" Foreground="#8F8F8F" Margin="10,0" />
                            <TextBlock FontSize="12">
                                <Hyperlink x:Name="btnEditUnits" Style="{StaticResource Link}"
                                           Click="EditUnits_Click">Units &amp; format</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <Rectangle Height="12" Fill="Transparent" />
                    </StackPanel>

                    <!-- Info banner (ITM wheels; same text as before) -->
                    <Border x:Name="borderItmInfo" Visibility="Collapsed"
                            Background="#1A4488CC" BorderBrush="#4488CC" BorderThickness="1"
                            CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock Foreground="#AADDFF" FontSize="12" TextWrapping="Wrap">
                            &#x2139;  This wheel has an ITM telemetry display — FanaBridge shows live SimHub telemetry on its pages (speed, gear, lap times, tire temps, and more). Pick the page each game starts on below, and use the wheel's display button to switch pages while driving. Its legacy page shows the virtual pages you set up under Legacy screens.
                        </TextBlock>
                    </Border>

                    <!-- ITM options (parity with the old Screen tab; Enable ITM lives in the
                         header's DISPLAY MODE toggle) -->
                    <styles:SHSubSection x:Name="sectionItmOptions" Title="ITM Options"
                                         Visibility="Collapsed">
                        <StackPanel>
                            <!-- Starting page (choices populated per display device) -->
                            <StackPanel x:Name="panelDefaultPage" Margin="0,2,0,12">
                                <TextBlock Text="Starting Page" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="cmbDefaultPage"
                                          SelectionChanged="CmbDefaultPage_SelectionChanged"
                                          Width="220" HorizontalAlignment="Left" />
                                <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                    The display returns to this page each time a game starts. Use the wheel's display button to switch pages while driving; the next game starts back here. Pick the legacy page here if you'd rather start on that.
                                </TextBlock>
                            </StackPanel>

                            <!-- Lap/position "/total" toggles retired: format lives in the
                                 Pages editor's Unit & format dropdown (Phase 6b). Settings
                                 booleans stay honored on the wire for one release. -->
                        </StackPanel>
                    </styles:SHSubSection>

                    <!-- Legacy Overview: LIVE mirror + priority list + links into Virtual
                         pages / Triggers (legacy mode). Shown on basic wheels, and on ITM
                         wheels in Legacy-only control — there the face is hosted in the
                         wide ITM-sized panel (same physical display, same card size). -->
                    <StackPanel x:Name="panelLegacyLive" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="LIVE MIRROR" Style="{StaticResource KLabel}" />
                                            <TextBlock Text="legacy · 3-char" FontSize="10.5"
                                                       Foreground="#8F8F8F" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock FontSize="11.5" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <Hyperlink x:Name="btnEditVirtualPages" Style="{StaticResource Link}"
                                                       Click="EditLegacy_Click">Edit virtual pages →</Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                    <!-- Face chrome is caps-dependent (ApplyLegacyFaceHost): the small
                                         basic face keeps this padded #0B0D0F frame; the wide ITM-sized
                                         face gets the ItmDisplayMirror border exactly (no padding), so
                                         the mirror region matches the ITM card pixel-for-pixel. -->
                                    <Border x:Name="borderLegacyFace" Background="#0B0D0F"
                                            BorderBrush="#262C31" BorderThickness="1"
                                            CornerRadius="6" Padding="9" Margin="0,9,0,8"
                                            HorizontalAlignment="Center">
                                        <ContentControl x:Name="hostLegacyFace" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="txtLegacyCaption" FontSize="12.5"
                                               Foreground="#B0B0B0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource KLabel}"
                                               Margin="0,0,0,9" />
                                    <StackPanel x:Name="panelLegacyActivity" />
                                    <TextBlock x:Name="txtLegacyNoActivity" Text="No activity yet."
                                               FontSize="12" Foreground="#7A7A7A" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Display priority" FontSize="13.5"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="— top eligible trigger wins" FontSize="12"
                                           Foreground="#8F8F8F" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock FontSize="11.5" HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Hyperlink x:Name="btnLegacyManageTriggers" Style="{StaticResource Link}"
                                           Click="ManageTriggers_Click">Edit triggers →</Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Rectangle Height="1" Fill="#3D3D3F" Margin="0,7,0,10" />
                        <shared:TriggerTableControl x:Name="legacyMonitorTable" />
                        <StackPanel x:Name="panelLegacyNoTriggers" Visibility="Collapsed" Margin="0,2,0,4">
                            <TextBlock Text="No triggers configured yet." FontSize="12"
                                       Foreground="#8F8F8F" Margin="0,0,0,8" />
                            <Button Content="＋ Add trigger" Click="OverviewAddTrigger_Click"
                                    Padding="12,4" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="#333333" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <TextBlock Text="Also edit:" FontSize="12" Foreground="#8F8F8F" />
                            <TextBlock FontSize="12" Margin="14,0,0,0">
                                <Hyperlink Style="{StaticResource Link}" Click="ManageTriggers_Click">All triggers</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="·" FontSize="12" Foreground="#8F8F8F" Margin="10,0" />
                            <TextBlock FontSize="12">
                                <Hyperlink Style="{StaticResource Link}" Click="EditLegacy_Click">Virtual pages</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Triggers editor (its own UserControl; the shell binds it and routes
                     navigation/poll snapshots in — see DisplayTriggersView). -->
                <ui:DisplayTriggersView x:Name="viewTriggers" Visibility="Collapsed" />

                <!-- Pages & fields editor (Bind/Enter/Poll/BackRequested — same seam as
                     Triggers). EditPages and EditUnits both land here. -->
                <ui:DisplayPagesView x:Name="viewPages" Visibility="Collapsed" />

                <!-- Virtual pages editor (legacy 3-char screen library). -->
                <ui:DisplayVirtualPagesView x:Name="viewLegacy" Visibility="Collapsed" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
