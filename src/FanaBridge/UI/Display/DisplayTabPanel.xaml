<UserControl x:Class="FanaBridge.UI.Display.DisplayTabPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FanaBridge.UI.Display"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FanaBridge;component/UI/Display/Shared/DisplayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="8">
            <Border x:Name="panelBakePending"
                    Style="{StaticResource Card}"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,28,0,0"
                    Padding="18,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="txtBakePendingTitle"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#F0F0F0" />
                    <TextBlock x:Name="txtBakePendingBody"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="#C8C8C8"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="txtBakePendingDisconnected"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="#9A9A9A"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ui:DisplayOverviewV2View x:Name="viewOverviewV2"
                                      Visibility="Collapsed" />
            <ui:DisplayDiagnosticsView x:Name="viewDiagnostics"
                                       Visibility="Collapsed" />
            <ui:DisplayPriorityV2View x:Name="viewPriorityV2"
                                      Visibility="Collapsed" />
            <ui:DisplayPagesFieldsV2View x:Name="viewPagesFieldsV2"
                                         Visibility="Collapsed" />
            <ui:DisplayAddPageV2View x:Name="viewAddPageV2"
                                     Visibility="Collapsed" />
        </Grid>
    </ScrollViewer>
</UserControl>
