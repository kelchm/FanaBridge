<UserControl x:Class="FanaBridge.UI.Display.DisplayTriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:FanaBridge.UI.Display.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FanaBridge;component/UI/Display/Shared/DisplayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostBack}" Click="Back_Click">
                    <TextBlock Style="{StaticResource GhostBackGlyph}" />
                </Button>
                <TextBlock Text="Triggers" Style="{StaticResource EditorTitle}" />
                <TextBlock Text="click a trigger to edit · drag ⠿ to reorder" FontSize="12"
                           Foreground="#8F8F8F" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="btnTriggersAdd" Content="＋ Add trigger"
                    Click="TriggersAdd_Click" Padding="12,5"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- The dense v9 trigger grid + expand-to-edit drawer: the shared trigger table
             (row machinery lives in the control; this view feeds it rows + drawer) -->
        <shared:TriggerTableControl x:Name="triggerTable" />

        <TextBlock x:Name="txtTriggersEmpty" Visibility="Collapsed"
                   Text="No triggers yet — use ＋ Add trigger to create one."
                   FontSize="12" Foreground="#8F8F8F" Margin="0,2,0,0" />

        <!-- BASE PAGE footer (built in code-behind): the "Always" resting page -->
        <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,13,0,0">
            <StackPanel x:Name="panelBaseFooter" />
        </Border>
    </StackPanel>
</UserControl>
