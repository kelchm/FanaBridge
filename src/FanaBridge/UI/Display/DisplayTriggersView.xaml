<UserControl x:Class="FanaBridge.UI.Display.DisplayTriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FanaBridge;component/UI/Display/Shared/DisplayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostBack}" Click="Back_Click">
                    <TextBlock Style="{StaticResource GhostBackGlyph}" />
                </Button>
                <TextBlock Text="Triggers" Style="{StaticResource EditorTitle}" />
                <TextBlock Text="drag ⠿ to reorder priority" FontSize="12"
                           Foreground="#8F8F8F" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="btnTriggersAdd" Content="＋ Add trigger"
                    Click="TriggersAdd_Click" Padding="12,5"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Add-trigger card (built in code-behind; collapsed until opened) -->
        <StackPanel x:Name="panelAddCard" Visibility="Collapsed" Margin="0,0,0,12" />

        <!-- Priority-ordered rule rows + the pinned base row (code-behind) -->
        <StackPanel x:Name="panelTriggerRows" />

        <TextBlock x:Name="txtTriggersEmpty" Visibility="Collapsed"
                   Text="No triggers yet — use ＋ Add trigger to create one."
                   FontSize="12" Foreground="#8F8F8F" Margin="0,2,0,0" />
    </StackPanel>
</UserControl>
