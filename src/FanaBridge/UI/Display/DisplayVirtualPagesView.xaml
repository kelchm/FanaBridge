<UserControl x:Class="FanaBridge.UI.Display.DisplayVirtualPagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FanaBridge;component/UI/Display/Shared/DisplayStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: ‹ back + title. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource GhostBack}" Click="Back_Click">
                <TextBlock Style="{StaticResource GhostBackGlyph}" />
            </Button>
            <TextBlock x:Name="txtTitle" Text="Virtual pages" Style="{StaticResource EditorTitle}" />
            <TextBlock x:Name="txtSubtitle" FontSize="12" Foreground="#8F8F8F"
                       Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Page pills + dashed ＋ (built in code-behind). -->
        <WrapPanel x:Name="panelPagePills" Margin="0,0,0,15" />

        <!-- Editor card | LIVE preview. -->
        <Grid x:Name="panelEditor" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,17"
                    VerticalAlignment="Top">
                <StackPanel x:Name="panelFields" />
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,15"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="LIVE" Style="{StaticResource KLabel}" Margin="0,0,0,10" />
                    <Border Background="#0B0D0F" BorderBrush="#262C31" BorderThickness="1"
                            CornerRadius="6" Padding="9" HorizontalAlignment="Center">
                        <!-- SevenSegmentFace is created in code-behind (no XAML type import). -->
                        <ContentControl x:Name="hostLiveFace" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="txtLiveHint" FontSize="11" Foreground="#7C7C7C"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="txtEmpty" Visibility="Collapsed"
                   Text="No virtual pages yet — use ＋ to create one."
                   FontSize="12" Foreground="#8F8F8F" Margin="0,4,0,0" />

        <!-- Base row: When nothing's firing → screen | Blank -->
        <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,13,0,0">
            <StackPanel x:Name="panelBaseRow" />
        </Border>
    </StackPanel>
</UserControl>
