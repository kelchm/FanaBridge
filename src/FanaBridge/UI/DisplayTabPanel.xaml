<UserControl x:Class="FanaBridge.UI.DisplayTabPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:FanaBridge.UI"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <!-- The design's small uppercase key label ("DISPLAY MODE", "LIVE", …). -->
        <Style x:Key="KLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#8F8F8F" />
        </Style>
        <!-- Card container (current page / recent activity). -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#303032" />
            <Setter Property="BorderBrush" Value="#3D3D3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <!-- Inline link ("Manage triggers →") — the house's Hyperlink-with-Click
             affordance (see SettingsControl), in the design's link blue. A real
             Hyperlink gives click (not press) semantics, keyboard focus, and
             Enter/Space activation. -->
        <Style x:Key="Link" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#3A9FE0" />
            <Setter Property="TextDecorations" Value="None" />
        </Style>
        <!-- The editors' ‹ ghost back button (design's .ghost square) — a real Button
             (the house's back-navigation primitive, wizard dialog) templated to the
             design's ghost look. -->
        <Style x:Key="GhostBack" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#3A3A3C" />
            <Setter Property="BorderBrush" Value="#565658" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Back to Overview" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One segment of the DISPLAY MODE toggle: a real Button (click semantics,
             keyboard focus, UIAutomation) templated to the design's rounded segment;
             the per-side corner set rides in Tag so both segments share the style. -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBackGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x2039;" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-2,0,0" />
        </Style>
        <Style x:Key="EditorTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="Margin" Value="11,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">

            <!-- ── Header strip: DISPLAY MODE segmented toggle (ITM wheels only) ── -->
            <StackPanel x:Name="panelModeHeader" Orientation="Horizontal" Margin="0,0,0,4"
                        Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="DISPLAY MODE" Style="{StaticResource KLabel}" Margin="0,0,0,5" />
                    <Border Background="#1A1A1B" BorderBrush="#45454A" BorderThickness="1"
                            CornerRadius="5" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnModeItm" Style="{StaticResource SegmentButton}"
                                    Click="ModeItm_Click">
                                <Button.Tag><CornerRadius>4,0,0,4</CornerRadius></Button.Tag>
                                <TextBlock x:Name="txtModeItm" Text="ITM display" FontSize="12" />
                            </Button>
                            <Button x:Name="btnModeLegacy" Style="{StaticResource SegmentButton}"
                                    Click="ModeLegacy_Click">
                                <Button.Tag><CornerRadius>0,4,4,0</CornerRadius></Button.Tag>
                                <TextBlock x:Name="txtModeLegacy" Text="Legacy only" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="txtModeHint" FontSize="11.5" Foreground="#8F8F8F"
                           TextWrapping="Wrap" MaxWidth="280" Margin="16,0,0,2"
                           VerticalAlignment="Bottom" />
            </StackPanel>
            <Rectangle x:Name="lineModeHeader" Height="1" Fill="#3A3A3A" Margin="0,10,0,12"
                       Visibility="Collapsed" />

            <!-- ── Views (hub-and-spoke: Overview is the landing view; editors are
                 reached only through its contextual links and return via ‹) ── -->
            <Grid>

                <!-- Overview -->
                <StackPanel x:Name="viewOverview">

                    <!-- Live cards: current page + recent activity (ITM display mode only) -->
                    <StackPanel x:Name="panelItmLive">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Current page card: the live display mirror (digital twin),
                                 with the state caption in the header — the panel itself
                                 stays clean like the hardware — and the page caption below. -->
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="LIVE" Style="{StaticResource KLabel}" />
                                            <Ellipse Width="6" Height="6" Fill="#35E06A"
                                                     Margin="7,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="txtMirrorState" FontSize="10.5"
                                                       Foreground="#8F8F8F" Margin="9,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock FontSize="11.5" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <Hyperlink x:Name="btnEditPages" Style="{StaticResource Link}"
                                                       Click="EditPages_Click">Edit pages &amp; fields →</Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                    <Border BorderBrush="#262C31" BorderThickness="1"
                                            Margin="0,9,0,8" HorizontalAlignment="Center">
                                        <ui:ItmDisplayMirror x:Name="displayMirror" />
                                    </Border>
                                    <TextBlock x:Name="txtCurrentPage" FontSize="12.5"
                                               Foreground="#B0B0B0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Recent activity card -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource KLabel}"
                                               Margin="0,0,0,9" />
                                    <StackPanel x:Name="panelActivity" />
                                    <TextBlock x:Name="txtNoActivity" Text="No activity yet."
                                               FontSize="12" Foreground="#7A7A7A" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Display priority list -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Display priority" FontSize="13.5"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="— top wins" FontSize="12" Foreground="#8F8F8F"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock FontSize="11.5" HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Hyperlink x:Name="btnManageTriggers" Style="{StaticResource Link}"
                                           Click="ManageTriggers_Click">Manage triggers →</Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Rectangle Height="1" Fill="#3D3D3F" Margin="0,7,0,10" />
                        <StackPanel x:Name="panelPriorityRows" />
                        <StackPanel x:Name="panelNoTriggers" Visibility="Collapsed" Margin="0,2,0,4">
                            <TextBlock Text="No triggers configured yet." FontSize="12"
                                       Foreground="#8F8F8F" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnAddTrigger" Content="Add trigger"
                                        IsEnabled="False" Padding="12,4" />
                                <TextBlock Text="(editor coming next)" FontSize="11.5"
                                           Foreground="#7A7A7A" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Footer links to the remaining editors (design's "Also edit:" row) -->
                        <Rectangle Height="1" Fill="#333333" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Also edit:" FontSize="12" Foreground="#8F8F8F" />
                            <TextBlock FontSize="12" Margin="14,0,0,0">
                                <Hyperlink x:Name="btnEditLegacy" Style="{StaticResource Link}"
                                           Click="EditLegacy_Click">Legacy screens (Page 6)</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="·" FontSize="12" Foreground="#8F8F8F" Margin="10,0" />
                            <TextBlock FontSize="12">
                                <Hyperlink x:Name="btnEditUnits" Style="{StaticResource Link}"
                                           Click="EditUnits_Click">Units &amp; format</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <Rectangle Height="12" Fill="Transparent" />
                    </StackPanel>

                    <!-- Info banner (ITM wheels; same text as before) -->
                    <Border x:Name="borderItmInfo" Visibility="Collapsed"
                            Background="#1A4488CC" BorderBrush="#4488CC" BorderThickness="1"
                            CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock Foreground="#AADDFF" FontSize="12" TextWrapping="Wrap">
                            &#x2139;  This wheel has an ITM telemetry display — FanaBridge shows live SimHub telemetry on its pages (speed, gear, lap times, tire temps, and more). Pick the page each game starts on below, and use the wheel's display button to switch pages while driving. Its legacy page shows the simple gear/speed display picked under Legacy Display Mode; choose "None" to leave that off.
                        </TextBlock>
                    </Border>

                    <!-- ITM options (parity with the old Screen tab; Enable ITM lives in the
                         header's DISPLAY MODE toggle) -->
                    <styles:SHSubSection x:Name="sectionItmOptions" Title="ITM Options"
                                         Visibility="Collapsed">
                        <StackPanel>
                            <!-- Starting page (choices populated per display device) -->
                            <StackPanel x:Name="panelDefaultPage" Margin="0,2,0,12">
                                <TextBlock Text="Starting Page" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="cmbDefaultPage"
                                          SelectionChanged="CmbDefaultPage_SelectionChanged"
                                          Width="220" HorizontalAlignment="Left" />
                                <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                    The display returns to this page each time a game starts. Use the wheel's display button to switch pages while driving; the next game starts back here. Pick the legacy gear/speed page here if you'd rather start on that.
                                </TextBlock>
                            </StackPanel>

                            <!-- "/total" suffixes -->
                            <StackPanel x:Name="panelTotals" Margin="0,0,0,12">
                                <TextBlock Text="Totals" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6">
                                    Show "/total" on the lap and position fields (e.g. "Lap 5 / 34" rather than "Lap 5"). Turn off for games that don't report usable totals.
                                </TextBlock>
                                <CheckBox x:Name="chkShowLapTotal" Content="Show lap total (Lap 5 / 34)"
                                          Checked="ItmOption_Changed" Unchecked="ItmOption_Changed" Margin="0,2" />
                                <CheckBox x:Name="chkShowPositionTotal" Content="Show position total (P3 / 20)"
                                          Checked="ItmOption_Changed" Unchecked="ItmOption_Changed" Margin="0,4,0,2" />
                            </StackPanel>
                        </StackPanel>
                    </styles:SHSubSection>

                    <!-- 7-segment display mode. Titled "Legacy Display Mode" (with a "None"
                         option) on ITM wheels; plain "Display Mode" on basic wheels. -->
                    <styles:SHSubSection x:Name="sectionDisplayMode" Title="Display Mode">
                        <ComboBox x:Name="cmbDisplayMode"
                                  SelectionChanged="CmbDisplayMode_SelectionChanged"
                                  Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem x:Name="cmbItemNone" Content="None" Tag="None" Visibility="Collapsed" />
                            <ComboBoxItem Content="Gear" Tag="Gear" />
                            <ComboBoxItem Content="Speed" Tag="Speed" />
                            <ComboBoxItem Content="Gear + Speed" Tag="GearAndSpeed" />
                            <ComboBoxItem Content="Gear + Upshift Brackets" Tag="GearUpshiftBrackets" />
                        </ComboBox>
                    </styles:SHSubSection>
                </StackPanel>

                <!-- Placeholder editor views: honest navigation, no fake UI. Each keeps
                     the design's editor header — ‹ ghost back button + title. -->
                <StackPanel x:Name="viewTriggers" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource GhostBack}" Click="Back_Click">
                            <TextBlock Style="{StaticResource GhostBackGlyph}" />
                        </Button>
                        <TextBlock Text="Triggers" Style="{StaticResource EditorTitle}" />
                    </StackPanel>
                    <TextBlock Text="The Triggers editor is coming in a later update."
                               FontSize="12" Foreground="#8F8F8F" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel x:Name="viewPages" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource GhostBack}" Click="Back_Click">
                            <TextBlock Style="{StaticResource GhostBackGlyph}" />
                        </Button>
                        <TextBlock Text="Pages &amp; fields" Style="{StaticResource EditorTitle}" />
                    </StackPanel>
                    <TextBlock Text="The Pages &amp; fields editor (including units &amp; format) is coming in a later update."
                               FontSize="12" Foreground="#8F8F8F" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel x:Name="viewLegacy" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource GhostBack}" Click="Back_Click">
                            <TextBlock Style="{StaticResource GhostBackGlyph}" />
                        </Button>
                        <TextBlock Text="Legacy screens (Page 6)" Style="{StaticResource EditorTitle}" />
                    </StackPanel>
                    <TextBlock Text="The Legacy screens editor is coming in a later update."
                               FontSize="12" Foreground="#8F8F8F" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
