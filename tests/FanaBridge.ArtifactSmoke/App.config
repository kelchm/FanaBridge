<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- SimHub.Logging configures log4net from the host's config; an empty
       section keeps it quiet here instead of printing a config error. -->
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <log4net />
</configuration>
