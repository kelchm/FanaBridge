<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Nullable annotations start here (our own code, no unannotated SimHub
         API pressure); production files opt in per-file as they are touched. -->
    <Nullable>enable</Nullable>
    <!-- The panel-factory fakes implement IDevicePanelFactory, whose methods
         return WPF Controls (the tests never construct one). -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FanaBridge\FanaBridge.csproj" />
    <!-- Explicit (though transitive via the plugin): most of the suite tests
         Core types directly and uses its internals via InternalsVisibleTo. -->
    <ProjectReference Include="..\..\src\FanaBridge.Core\FanaBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SimHubDir)Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>$(SimHubDir)GameReaderCommon.dll</HintPath>
    </Reference>
    <Reference Include="BA63Driver">
      <HintPath>$(SimHubDir)BA63Driver.dll</HintPath>
    </Reference>
    <!-- IVariantProvider lives here; the Control Mapper bridge tests build fake
         doubles of SimHub's reflection targets against the real interface. -->
    <Reference Include="SimHub.Plugins">
      <HintPath>$(SimHubDir)SimHub.Plugins.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Provides .NET Framework 4.8 reference assemblies for builds without VS -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests locate the SimHub install the build compiled against. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SimHubDir</_Parameter1>
      <_Parameter2>$(SimHubDir)</_Parameter2>
    </AssemblyAttribute>
    <None Include="Snapshots\SimHub.FanatecManaged.enums.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Canonical catalogs live in FanaBridge.Core (CatalogLoader.LoadShipped). -->
    <EmbeddedResource Include="Display\Fixtures\evaluator-differential-traces.golden.txt" />
    <!-- FA2: frozen v2 counterparts for the FrameComposer parity battery (v1 stays inline). -->
    <EmbeddedResource Include="Display\Fixtures\parity-pairs\*.v2.json" />
  </ItemGroup>

</Project>
